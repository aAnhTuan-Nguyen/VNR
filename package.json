{
  "name": "complete-shelf-threeui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run library:build && vite",
    "library:build": "node scripts/build-history-library.mjs",
    "library:vendor": "node scripts/vendor-shelf-runtime.mjs",
    "library:covers": "npm run library:build && node scripts/export-library-covers.mjs",
    "build": "npm run library:build && tsc -p tsconfig.build.json --noEmit && vite build",
    "test": "vitest run --maxWorkers=2",
    "preview": "vite preview",
    "demo": "npm run build && vite preview --host 127.0.0.1",
    "source:sync": "node scripts/fetch-threeui-source.mjs",
    "test:e2e": "npm run build && node tests/e2e/history-library.smoke.mjs"
  },
  "dependencies": {
    "@designcodeio/threeui": "1.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright": "1.61.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
